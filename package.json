{
  "name": "codifyai",
  "version": "1.0.0",
  "private": true,
  "description": "Codify - A structured text editor combining document expressiveness with database structure",
  "scripts": {
    "dev": "concurrently \"npm run dev:convex\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:convex": "convex dev",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "test": "npm run test --prefix client"
  },
  "dependencies": {
    "convex": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
